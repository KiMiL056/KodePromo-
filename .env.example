# Aplikasi Utama (KodePromo REST API)
APP_NAME=KodePromo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Database MySQL
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kodepromo
DB_USERNAME=kodepromo_user
DB_PASSWORD=ubah_password_di_env_lokal

# Docker Hub & Image Tag
DOCKERHUB_USERNAME=username_dockerhub
IMAGE_TAG=latest

# E-Commerce Demo (Client API)
DEMO_APP_PORT=8080
KODEPROMO_API_URL=http://api:8000
KODEPROMO_API_KEY=isi_api_key_merchant_di_env_lokal
